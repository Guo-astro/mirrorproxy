{
  "name": "mirrorproxy-web",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=4173 max dev",
    "build": "max setup && tsc --noEmit && max build && node scripts/check-browser-build.mjs",
    "preview": "max preview --port 4173",
    "pretest": "node scripts/check-docker-context.mjs && node scripts/check-browser-dependencies.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "max setup"
  },
  "dependencies": {
    "@multiavatar/multiavatar": "^1.0.7",
    "lucide-react": "^0.560.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@umijs/max": "4.7.27",
    "antd": "6.6.7",
    "@ant-design/pro-components": "3.1.14-2",
    "@ant-design/icons": "6.3.2",
    "@ant-design/plots": "2.6.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.0",
    "vite": "8.1.6",
    "@types/node": "^24.0.0",
    "cross-env": "10.1.0",
    "crypto-browserify": "file:build/no-node-crypto"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    },
    "path-to-regexp@>=8 <8.4.2": "8.4.2",
    "immer@<9.0.6": "9.0.21",
    "node-fetch@<2.6.7": "2.7.0",
    "axios@<0.34.0": "0.34.0",
    "path-to-regexp@>=1 <1.9.0": "1.9.0",
    "postcss@>=8 <8.5.23": "8.5.31",
    "vite@>=7 <7.3.7": "7.3.7",
    "@babel/core@>=7 <7.29.6": "7.29.7",
    "@babel/runtime@>=7 <7.26.10": "7.29.7",
    "decode-uri-component@<=0.4.2": "0.5.1",
    "postcss-selector-parser@<7.1.6": "7.1.7",
    "esbuild@<=0.24.2": "0.25.12",
    "react-router@>=6 <7": "7.18.4",
    "react-router-dom@>=6 <7": "7.18.4",
    "crypto-browserify": "$crypto-browserify",
    "@umijs/renderer-react": {
      "react-helmet-async": "3.0.0"
    },
    "@umijs/bundler-utoopack": {
      "less-loader": "12.3.3"
    },
    "use-sync-external-store@<1.7.0": "1.7.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js": false,
    "core-js-pure": false,
    "es5-ext": false
  }
}
